# ── TMDB（非商業階段用免費 key；一旦收費須升級商業訂閱）──────────────
TMDB_API_KEY=
NUXT_TMDB_API_KEY=

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=                 # sb_publishable_… 可公開曝露
SUPABASE_SECRET_KEY=          # sb_secret_… ★ 僅 server 端，絕不可加 NUXT_PUBLIC_
SUPABASE_PROJECT_ID=          # 只給 npm run db:types
DATABASE_URL=                 # postgresql://… ★ 只給 npm run db:sql 套 migration 用，含 DB 密碼

# ── 應用程式 ─────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_CRON_SECRET=
COPYRIGHT_CONTACT_EMAIL=

# ── 舊 log 匯入（scripts/import-mylog.ts）─────────────────────────────
# 要把觀影紀錄匯給哪一位使用者，以 auth.users 的 email 精確指定。
# 刻意不提供預設值也不寫死在程式碼裡：DB 內有多個 session 建的測試帳號，
# 用「唯一一筆 profile」之類的假設猜錯，會把紀錄匯到別人身上。
# 也可以用 CLI 參數傳：pnpm import:mylog -- --email <address> --apply
IMPORT_TARGET_EMAIL=
