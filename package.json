{
  "name": "filmnote",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "影記 — 台灣在地觀影紀錄",
  "imports": {
    "#pipeline/*": "./src/*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --env-file=.env scripts/seed-supabase.ts",
    "db:types": "tsx --env-file=.env scripts/gen-types.ts",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:pipeline",
    "typecheck:app": "nuxt typecheck",
    "typecheck:pipeline": "tsc -p tsconfig.pipeline.json --noEmit",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint . --fix",
    "ingest:rating": "tsx src/pipeline/ingest-rating.ts",
    "ingest:cinema": "tsx src/pipeline/ingest-cinema.ts",
    "db:sql": "tsx --env-file=.env scripts/db.ts",
    "import:mylog": "tsx --env-file=.env scripts/import-mylog.ts",
    "tmdb:backfill": "tsx --env-file=.env scripts/tmdb-backfill.ts",
    "verify:all": "tsx --env-file=.env scripts/verify-all.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@resvg/resvg-js": "2.6.2",
    "@supabase/supabase-js": "^2.115.0",
    "csv-parse": "^7.0.2",
    "echarts": "^6.1.0",
    "nuxt": "4.5.2",
    "satori": "0.33.4",
    "tailwindcss": "^4.3.3",
    "vue-echarts": "^8.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-oxlint": "^1.81.0",
    "oxlint": "^1.81.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "overrides": {
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true,
    "fsevents@2.3.3": true
  }
}
